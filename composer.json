{
  "name": "alter-consult/alter-consult-new-look",
  "description": "Alter Consult Drupal 11 website",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  ],
  "require": {
    "php": ">=8.1",
    "drupal/core": "^11.0",
    "drupal/core-composer-scaffold": "^11.0",
    "drupal/core-project-message": "^11.0",
    "drupal/core-recommended": "^11.0",
    "drupal/gin": "^5.0",
    "drupal/olivero": "^11.0",
    "drupal/key": "^2.0",
    "composer/installers": "^2.2",
    "oomphinc/composer-installers-extender": "^2.0"
  },
  "require-dev": {
    "drupal/core-dev": "^11.0",
    "drush/drush": "^13.0",
    "phpunit/phpunit": "^10.0"
  },
  "extra": {
    "installer-paths": {
      "web/core": ["type:drupal-core"],
      "web/libraries/{$name}": ["type:drupal-library"],
      "web/modules/contrib/{$name}": ["type:drupal-module"],
      "web/profiles/contrib/{$name}": ["type:drupal-profile"],
      "web/themes/contrib/{$name}": ["type:drupal-theme"],
      "drush/Commands/{$name}": ["type:drupal-drush"]
    },
    "drupal-scaffold": {
      "locations": {
        "web-root": "web/"
      }
    },
    "enable-patching": true
  },
  "scripts": {
    "post-install-cmd": [
      "@composer drupal-scaffold",
      "DrupalComposerManaged\\ComposerScripts::postInstall"
    ],
    "post-update-cmd": [
      "@composer drupal-scaffold",
      "DrupalComposerManaged\\ComposerScripts::postUpdate"
    ]
  },
  "config": {
    "sort-packages": true,
    "platform-check": false,
    "allow-plugins": {
      "composer/installers": true,
      "drupal/core-composer-scaffold": true,
      "drupal/core-project-message": true,
      "oomphinc/composer-installers-extender": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
